<h1><%= @book.title %>!</h1>
<p>Change <%= @book.title %>'s title </p>


<div>

<%= form_for(@book) do |b| %>
    <% %>
    <table summary="Book form fields">
        <tr>
            <th>Title</th>
            <td><%= b.text_field(:title) %></td>
        </tr>

    </table>


    <div >
        <%= b.submit("Update Book") %>
    </div>

<% end %> 
<%= link_to("<< back", {controller: "main", action: "index"}) %>
