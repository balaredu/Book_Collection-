<h1>Add a Book!</h1>
<p>Enter in your text to add a book!</p>
<div>

<%= form_for(@book) do |b| %>
    
    <table summary="Book form fields">
        <tr>
            <th>Title</th>
            <td><%= b.text_field(:title) %></td>
        </tr>
        <tr>
            <th>Author</th>
            <td><%= b.text_field(:author) %></td>
        </tr>
        <tr>
            <th>Price</th>
            <td><%= b.number_field(:price) %></td>
        </tr>
        <tr>
            <th>Date</th>
            <td><%= b.date_select(:published_date) %></td>
        </tr>

    </table>


    <div >
        <%= b.submit("Create Book") %>
    </div>

<% end %> 





<%= link_to("<< back", {controller: "main", action: "index"}) %>

</div>

