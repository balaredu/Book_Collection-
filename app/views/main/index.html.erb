<h1>Welcome to book collection</h1>
<p>Books are displayed on the list below, feel free to click delete to delete a book, edit to update it, or details to view the details of a book!</p>
<table class='listing' summary='Book titles' style="width: 100%">
    <tr class="header">
        <th>#</th>
        <th>Title</th>
        <th>Actions</th>
    </tr>
    <% @all_books.each_with_index do |book, index| %>
    <tr>
        <td><%= index + 1 %></td>
        <td><%= book.title %></td>
        <td class="actions">
            <%= link_to("edit", edit_book_path(book)) %>
            <%= link_to("show details", book_path(book)) %>
            <%= link_to("delete", delete_book_path(book)) %>
        </td>
    </tr>
    <% end %>
</table>
<%= link_to("Add a Book", new_book_path) %>